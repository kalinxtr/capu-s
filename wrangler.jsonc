{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "la-pizzeria",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": { "enabled": true },
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"services": [
		// Auto-referencia que usa OpenNext para su caché. Tiene que coincidir con "name".
		{ "binding": "WORKER_SELF_REFERENCE", "service": "la-pizzeria" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "la-pizzeria",
			"database_id": "00000000-0000-0000-0000-000000000000", // Reemplazar por el id que da `npx wrangler d1 create la-pizzeria`
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "la-pizzeria-imagenes" }],
	"ratelimits": [
		// Pedidos públicos por IP y por minuto, para que nadie vacíe el stock con un script.
		{ "name": "LIMITE_PEDIDOS", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } },
		// Intentos de ingreso al admin por IP y por minuto.
		{ "name": "LIMITE_INGRESO", "namespace_id": "2102", "simple": { "limit": 10, "period": 60 } }
	]
}
